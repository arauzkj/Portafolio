---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

interface Props {
  user?: {
    name?: string | null;
    email?: string | null;
  } | null;
}

const { user } = Astro.props;

const navItems = [
  { label: t("dashboard.title"), href: translatePath("/dashboard") },
  { label: t("nav.blog"), href: translatePath("/blog") },
];

const userName = user?.name ?? "Admin";
const userEmail = user?.email ?? "admin@blog.com";
const userInitial = userName.trim().charAt(0).toUpperCase() || "A";
---

<aside
  class="fixed left-0 top-0 z-40 h-screen w-64 border-r border-sidebar-border bg-sidebar"
>
  <div class="flex h-full flex-col">
    <div class="flex h-16 items-center border-b border-sidebar-border px-6">
      <a href={translatePath("/dashboard")} class="flex items-center gap-2">
        <div
          class="flex h-8 w-8 items-center justify-center rounded-md bg-accent"
        >
          <i class="h-4 w-4 text-accent-foreground"></i>
        </div>
        <span class="text-lg font-semibold text-sidebar-foreground">
          Blog CMS
        </span>
      </a>
    </div>

    <nav class="flex-1 space-y-1 p-4">
      {
        navItems.map((item) => {
          const isActive =
            Astro.url.pathname === item.href ||
            (item.href !== translatePath("/") &&
              Astro.url.pathname.startsWith(`${item.href}/`));

          return (
            <a
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "flex items-center gap-3 rounded-md px-3 py-2 text-sm font-medium transition-colors",
                isActive
                  ? "bg-sidebar-accent text-sidebar-accent-foreground"
                  : "text-sidebar-foreground/70 hover:bg-sidebar-accent/50 hover:text-sidebar-foreground",
              ]}
            >
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="border-t border-sidebar-border p-4">
      <div class="flex items-center gap-3">
        <div
          class="flex h-8 w-8 items-center justify-center rounded-full bg-secondary text-sm font-medium"
        >
          {userInitial}
        </div>
        <div class="flex-1">
          <p class="text-sm font-medium text-sidebar-foreground">{userName}</p>
          <p class="text-xs text-sidebar-foreground/60">{userEmail}</p>
        </div>
      </div>
    </div>
  </div>
</aside>
