---
import {
  getLangFromUrl,
  useTranslatedPath,
  useTranslations,
} from "@i18n/utils";

import { Icon } from "astro-icon/components";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

interface Props {
  user?: {
    name?: string | null;
    email?: string | null;
  } | null;
}

const { user } = Astro.props;

const navItems = [
  {
    label: t("dashboard.title"),
    href: translatePath("/dashboard"),
    icon: "lucide:layout-dashboard",
  },
  {
    label: lang === 'es' ? "Publicaciones" : "Posts",
    href: translatePath("/dashboard/post/edit"),
    icon: "mdi:post-it-note-edit",
  },
  {
    label: lang === 'es' ? "Nueva publicación" : "New post",
    href: translatePath("/dashboard/post/new"),
    icon: "mdi:note-add",
  },
  {
    label: lang === 'es' ? "Configuración" : "Settings",
    href: translatePath("/dashboard/settings"),
    icon: "mdi:settings-outline",
  },
];

const userName = user?.name ?? "Admin";
const userEmail = user?.email ?? "admin@blog.com";
const userInitial = userName.trim().charAt(0).toUpperCase() || "A";
---

<aside class="dashboard-sidebar">
  <div class="dashboard-sidebar__inner">
    <div class="dashboard-brand">
      <a href={translatePath("/dashboard")} class="dashboard-brand__link">
        <div class="dashboard-brand__mark">
          <Icon name="mdi:blog-outline" />
        </div>
        <span>Kevin<span class="dashboard-brand__accent">.cms</span></span>
      </a>
    </div>

    <nav class="dashboard-nav" aria-label="CMS navigation">
      {
        navItems.map((item) => {
          const isActive =
            Astro.url.pathname === item.href ||
            (item.href !== translatePath("/") &&
              Astro.url.pathname.startsWith(`${item.href}/`));

          return (
            <a
              href={item.href}
              aria-current={isActive ? "page" : undefined}
              class:list={[
                "dashboard-nav__link",
                isActive
                  ? "dashboard-nav__link--active"
                  : "",
              ]}
            >
              <Icon class="h-4 w-4" name={item.icon} />
              {item.label}
            </a>
          );
        })
      }
    </nav>

    <div class="dashboard-profile">
      <div class="dashboard-profile__avatar">
          {userInitial}
      </div>
      <div class="dashboard-profile__copy">
        <p>{userName}</p>
        <span>{userEmail}</span>
      </div>
    </div>
  </div>
</aside>
