---
import { getLangFromUrl } from '@i18n/utils';

export interface AlternateLink {
  lang: string;
  href: string;
}

interface Props {
  title: string;
  description: string;
  image?: string;
  canonicalURL?: string;
  type?: 'website' | 'article';
  publishedDate?: string;
  author?: string;
  alternateLinks?: AlternateLink[];
}

const {
  title,
  description,
  image = '/preview.webp',
  canonicalURL,
  type = 'website',
  publishedDate,
  author = 'K.Arauz',
  alternateLinks,
} = Astro.props;

const siteName = 'Kevin Arauz';
const fullTitle = `${title} | ${siteName}`;

// Base URL de producción garantizada (https://arauzkj.dev)
const siteBase = Astro.site ? new URL(Astro.site).origin : Astro.url.origin;

// Canonical URL normalizada siempre usando siteBase
const currentPathname = canonicalURL
  ? (canonicalURL.startsWith('http') ? new URL(canonicalURL).pathname : canonicalURL)
  : Astro.url.pathname;
const absoluteCanonicalUrl = new URL(currentPathname, siteBase).href;

const absoluteImage = new URL(image, siteBase).href;
const lang = getLangFromUrl(Astro.url);
const ogLocale = lang === 'en' ? 'en_US' : 'es_ES';

// Generar etiquetas hreflang para SEO internacional
const supportedLangs = ['es', 'en'];
const pathWithoutLang = currentPathname.replace(/^\/(es|en)(\/|$)/, '/');

const alternates: AlternateLink[] = alternateLinks ?? supportedLangs.map((l) => {
  const localizedPath = `/${l}${pathWithoutLang === '/' ? '/' : pathWithoutLang}`;
  return {
    lang: l,
    href: new URL(localizedPath, siteBase).href,
  };
});

const xDefaultHref = new URL(
  `/es${pathWithoutLang === '/' ? '/' : pathWithoutLang}`,
  siteBase
).href;

---

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={author} />
<meta name="robots" content="index,follow" />
<link rel="canonical" href={absoluteCanonicalUrl} />

<!-- Alternates (hreflang) para Google Search Console -->
{alternates.map((alt) => (
  <link rel="alternate" hreflang={alt.lang} href={alt.href} />
))}
<link rel="alternate" hreflang="x-default" href={xDefaultHref} />

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={absoluteImage} />
<meta property="og:image:secure_url" content={absoluteImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content={fullTitle} />
<meta property="og:url" content={absoluteCanonicalUrl} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content={ogLocale} />


<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={absoluteImage} />
<meta name="twitter:url" content={absoluteCanonicalUrl} />
<meta name="twitter:image:alt" content={fullTitle} />

<!-- Blog post específico -->
{publishedDate && <meta property="article:published_time" content={publishedDate} />}
{type === 'article' && <meta property="article:author" content={author} />}