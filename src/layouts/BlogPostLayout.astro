---
import Header from '@components/shared/Header.astro';
import SocialSideBar from '@components/shared/SocialSideBar.astro';
import Footer from '@components/shared/Footer.astro';
import Layout from '@layouts/Layout.astro';

type BlogLayoutPost = { slug: string; title: string; description: string; coverImage?: string | null; tags?: string[]; publishedAt?: Date | null; content?: string; };
interface Props { post: BlogLayoutPost; }

const { post } = Astro.props;
const lang = Astro.url.pathname.split('/')[1] === 'en' ? 'en' : 'es';
const locale = lang === 'en' ? 'en-US' : 'es-CR';
const labels = lang === 'en'
  ? { back: 'Back to the blog', reading: 'min read', article: 'Article' }
  : { back: 'Volver al blog', reading: 'min de lectura', article: 'Artículo' };
const formattedDate = post.publishedAt?.toLocaleDateString(locale, { year: 'numeric', month: 'long', day: 'numeric' });
const readingTime = Math.max(1, Math.ceil((post.content?.trim().split(/\s+/).length ?? 0) / 200));
const blogIndexHref = `/${lang}/blog`;
---

<Layout title={post.title} description={post.description} image={post.coverImage ?? '/preview.webp'} type="article" publishedDate={post.publishedAt?.toISOString()}>
  <Header />
  <SocialSideBar />
  <main class="blog-post">
    <article class="blog-post__article">
      <a href={blogIndexHref} class="blog-post__back"><span aria-hidden="true">←</span>{labels.back}</a>
      <header class="blog-post__header">
        <p class="blog-post__eyebrow">{labels.article}</p>
        {post.tags && post.tags.length > 0 && <ul class="blog-post__tags" aria-label="Tags">{post.tags.map((tag) => <li>#{tag}</li>)}</ul>}
        <h1>{post.title}</h1>
        <p class="blog-post__description">{post.description}</p>
        <div class="blog-post__meta">
          {formattedDate && <time datetime={post.publishedAt?.toISOString()}>{formattedDate}</time>}
          <span aria-hidden="true">·</span><span>{readingTime} {labels.reading}</span>
        </div>
      </header>
      {post.coverImage && <figure class="blog-post__cover"><img src={post.coverImage} alt={post.title} /></figure>}
      <div class="blog-prose"><slot /></div>
      <footer class="blog-post__footer"><a href={blogIndexHref} class="blog-post__back"><span aria-hidden="true">←</span>{labels.back}</a></footer>
    </article>
  </main>
  <Footer />
</Layout>
