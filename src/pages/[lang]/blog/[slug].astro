---
import { getCollection, render } from 'astro:content';
import BlogPost from '@layouts/BlogPostLayout.astro';
import DatabasePostContent from '@components/blog/DatabasePostContent.astro';
import { getPublishedPost } from '@lib/posts';

export const prerender = false;

const lang = Astro.params.lang === 'en' ? 'en' : 'es';
const slug = Astro.params.slug ?? '';
const markdownPost = (await getCollection('blog', ({ data }) => !data.draft))
  .find((post) => post.id === `${lang}/${slug}`);
const databasePost = markdownPost ? null : await getPublishedPost(slug, lang);

if (!markdownPost && !databasePost) return Astro.redirect(`/${lang}/blog`);

const { Content } = markdownPost ? await render(markdownPost) : { Content: null };
const post = markdownPost ?? databasePost!;

// Adaptamos los datos al formato que espera BlogPost.astro
const postData = {
  id:          markdownPost ? 0 : databasePost!.id,
  slug:        markdownPost ? markdownPost.id : databasePost!.slug,
  title:       markdownPost ? markdownPost.data.title : databasePost!.title,
  description: markdownPost ? markdownPost.data.description : databasePost!.description,
  coverImage:  markdownPost ? markdownPost.data.coverImage ?? null : databasePost!.coverImage,
  tags:        markdownPost ? markdownPost.data.tags : databasePost!.tags,
  publishedAt: markdownPost ? markdownPost.data.publishedAt : databasePost!.publishedAt,
  published:   true,
  createdAt:   markdownPost ? markdownPost.data.createdAt ?? null : databasePost!.createdAt,
  updatedAt:   markdownPost ? markdownPost.data.updatedAt ?? null : databasePost!.updatedAt,
  content:     markdownPost ? markdownPost.body ?? '' : databasePost!.content,
};
---

<BlogPost post={postData}>
  {markdownPost ? <Content /> : <DatabasePostContent content={databasePost!.content} />}
</BlogPost>
