---
import Layout from '@layouts/Layout.astro';
import Header from '@components/shared/Header.astro';
import SocialSideBar from '@components/shared/SocialSideBar.astro';
import Footer from '@components/shared/Footer.astro';
import Projects from '@components/projects/Projects.astro';
import { useTranslations } from '@i18n/utils';
import { languages } from '@i18n/ui';

export const prerender = true;

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}

const { lang } = Astro.params;
const t = useTranslations(lang as any);
---

<Layout title={`${t('nav.projects')} | ${t('site.title')}`} description={t('site.description')}>
  <Header />
  <SocialSideBar />

  <main class="pt-12 md:pt-16">
    <Projects />
  </main>

  <Footer />
</Layout>